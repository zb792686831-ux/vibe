{
  "name": "ai-video-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion + FFmpeg video workspace, 1920x1080 at 60fps",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000",
    "typecheck": "tsc --noEmit",
    "compositions": "remotion compositions src/index.ts",
    "render:test": "remotion render src/index.ts SetupTest output/remotion-test.mp4",
    "finalize:test": "node scripts/finalize-test.mjs",
    "verify:test": "node scripts/verify-test.mjs",
    "pretest:render": "node -e \"require('node:fs').rmSync('output/validation.json', {force: true})\"",
    "test:render": "npm run typecheck && npm run render:test && npm run finalize:test && npm run verify:test",
    "video:prepare": "python3 scripts/generate-new-media-v2-final-audio.py",
    "video:render": "node scripts/render-new-media-v2-final.mjs",
    "video:verify": "node scripts/verify-new-media-v2-final.mjs",
    "video:build": "npm run typecheck && npm run video:render && npm run video:verify",
    "video:legacy:prepare": "python3 scripts/prepare-new-media.py",
    "video:legacy:build": "node scripts/render-new-media.mjs && node scripts/verify-new-media.mjs",
    "style:r2:render": "remotion render src/index.ts NewMediaV2StyleTrialR2 output/new-media-v2-style-r2-trial.mp4 --concurrency=1 --gl=swangle --x264-preset=fast",
    "style:r2:frames": "node scripts/extract-new-media-v2-r2-frames.mjs",
    "style:r2:verify": "node scripts/verify-new-media-v2-style-r2.mjs",
    "motion:geometry": "node scripts/generate-motion-lab-geometry.mjs",
    "motion:audio": "python3 scripts/generate-motion-lab-audio.py",
    "motion:prepare": "node scripts/render-motion-lab.mjs --prepare-only",
    "motion:render": "node scripts/render-motion-lab.mjs",
    "motion:verify": "node scripts/verify-motion-lab.mjs",
    "motion:build": "npm run motion:input:check && npm run motion:geometry && npm run motion:audio && npm run motion:render && npm run motion:verify",
    "motion:input": "node scripts/prepare-motion-lab-input.mjs",
    "motion:input:check": "node scripts/prepare-motion-lab-input.mjs --check"
  },
  "dependencies": {
    "@remotion/fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/paths": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.537",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "gsap": "3.14.2",
    "hyperframes": "0.8.185",
    "typescript": "5.9.3"
  }
}
