{
  "durationSeconds": 130,
  "durationInFrames": 7800,
  "fps": 60,
  "width": 1920,
  "height": 1080,
  "voiceover": false,
  "captionFadeInSeconds": 0.55,
  "captionMicroTravelPx": 10,
  "subjectMotionDurationSeconds": [
    1.0,
